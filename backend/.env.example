# ==============================================================================
# MediVault Backend - Production Environment Variables Example (Render / Cloud)
# ==============================================================================

PORT=10000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
CORS_ORIGIN=https://your-medivault-frontend.vercel.app

# Database (Supabase PostgreSQL - Transaction Pooler Port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# File Storage (100% Free - NO Credit Card: Backblaze B2 10GB or Supabase Storage 1GB)
# Option A (Backblaze B2 - 10GB Free, No Card):
# MINIO_ENDPOINT=s3.us-east-005.backblazeb2.com
# MINIO_ACCESS_KEY=your_backblaze_keyID
# MINIO_SECRET_KEY=your_backblaze_applicationKey
# MINIO_BUCKET=medivault-docs-unique-name
#
# Option B (Supabase S3 - 1GB Free, Already have account):
# MINIO_ENDPOINT=YOUR_PROJECT_REF.storage.supabase.co
# MINIO_ACCESS_KEY=your_supabase_s3_access_key_id
# MINIO_SECRET_KEY=your_supabase_s3_secret_access_key
# MINIO_BUCKET=medivault-documents

MINIO_ENDPOINT=s3.us-east-005.backblazeb2.com
MINIO_PORT=443
MINIO_ACCESS_KEY=your_storage_access_key
MINIO_SECRET_KEY=your_storage_secret_key
MINIO_BUCKET=medivault-documents
MINIO_USE_SSL=true
MAX_FILE_SIZE_MB=50
SIGNED_URL_EXPIRY_SECONDS=3600

# Artificial Intelligence (Primary: Google Gemini, Fallback & Chat: NVIDIA NIM)
GEMINI_API_KEY=AIzaSy...
NVIDIA_NIM_API_KEY=nvapi-...
PRIMARY_MEDICAL_MODEL=gemini
FALLBACK_MEDICAL_MODEL=nvidia
CHAT_MODEL=nvidia
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Handwritten Prescription OCR Service (HuggingFace Spaces Docker Microservice)
PRESCRIPTION_OCR_SERVICE_URL=https://your_hf_username-medivault-ocr.hf.space
PRESCRIPTION_OCR_MODEL=chinmays18/medical-prescription-ocr
OCR_TIMEOUT_MS=30000

# In-Memory Cache (Upstash Redis)
REDIS_URL=rediss://:your_upstash_token@your_endpoint.upstash.io:6379

# Semantic Vector Search RAG (Qdrant Cloud Free Tier)
QDRANT_URL=https://your_cluster_id.ap-south-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
