# =============================================================
# MediVault Root .gitignore
# =============================================================

# 1. Ignore everything in root folder by default
/*

# 2. Whitelist ONLY necessary working directories & root files
!/backend/
!/frontend/
!/services/
!/contracts/
!/docker-compose.yml
!/.gitignore
!/README.md

# -------------------------------------------------------------
# Operating System & IDE Files
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# -------------------------------------------------------------
# Secrets, Environment & Auth
# -------------------------------------------------------------
.env
.env.*
!.env.example
auth.txt
*.pem
*.key
*.cert
*.crt
credentials.json
token.json

# -------------------------------------------------------------
# Logs & Temporary Files
# -------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
temp/
tmp/

# -------------------------------------------------------------
# Local Storage / MinIO / Large Binaries / Test Files
# -------------------------------------------------------------
minio.exe
minio/
minio_data/
uploads/
*.sqlite
*.db

# -------------------------------------------------------------
# Node / Frontend / Backend Dependencies & Build Output
# -------------------------------------------------------------
node_modules/
dist/
build/
.next/
out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/
*.tsbuildinfo
.eslintcache
.turbo/
.vercel/

# -------------------------------------------------------------
# AI Microservice (Python / FastAPI / PyTorch / HuggingFace)
# -------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution & packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
Lib/
Scripts/
pyvenv.cfg

# Test & coverage caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints

# AI Models / Weights / Caching (downloaded dynamically at runtime)
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.h5
*.tflite
*.joblib
*.pkl
*.pickle
*.traineddata
model_cache/
hf_cache/
huggingface/
checkpoints/
models_weights/
models/
